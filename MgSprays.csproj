<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>$(CssApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(CssApiPath)'))/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Localization.Abstractions">
      <HintPath>$([System.IO.Path]::GetDirectoryName('$(CssApiPath)'))/Microsoft.Extensions.Localization.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Update="lang/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>




